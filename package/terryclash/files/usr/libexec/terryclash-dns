#!/bin/sh
set -e
set -f

ROOT=/etc/terryclash
STATE=$ROOT/dnsmasq-backup
SECTION='dhcp.@dnsmasq[0]'
mkdir -p /var/lock "$ROOT"
exec 9>/var/lock/terryclash-dns.lock
flock -x 9

restore() {
	[ -d "$STATE" ] || return 0
	uci -q delete "$SECTION.noresolv" || true
	if [ -f "$STATE/had-noresolv" ]; then
		uci set "$SECTION.noresolv=$(cat "$STATE/noresolv")"
	fi
	uci -q delete "$SECTION.server" || true
	if [ -f "$STATE/had-server" ]; then
		while IFS= read -r server; do
			[ -z "$server" ] || uci add_list "$SECTION.server=$server"
		done < "$STATE/server"
	fi
	uci commit dhcp
	/etc/init.d/dnsmasq reload
	rm -f "$STATE/noresolv" "$STATE/server" "$STATE/had-noresolv" "$STATE/had-server"
	rmdir "$STATE"
}

apply() {
	[ "$(uci -q get "$SECTION" || true)" = dnsmasq ] || { echo 'dnsmasq section not found' >&2; return 1; }
	[ -s "$ROOT/run.yaml" ] || { echo 'Mihomo configuration not found' >&2; return 1; }
	if [ -d "$STATE" ] && [ "$(uci -q get "$SECTION.noresolv" || true)" = 1 ]; then
		case " $(uci -q get "$SECTION.server" || true) " in
			*' 127.0.0.1#1053 '*) return 0 ;;
		esac
	fi
	if [ ! -d "$STATE" ]; then
		tmp=$(mktemp -d "$ROOT/.dnsmasq-backup.XXXXXX")
		if uci -q get "$SECTION.noresolv" > "$tmp/noresolv"; then touch "$tmp/had-noresolv"; fi
		if servers=$(uci -q get "$SECTION.server"); then
			touch "$tmp/had-server"
			for server in $servers; do printf '%s\n' "$server" >> "$tmp/server"; done
		fi
		mv "$tmp" "$STATE"
	fi
	uci set "$SECTION.noresolv=1"
	uci -q delete "$SECTION.server" || true
	# Keep domain-specific forwarding, including local and service-hook rules.
	if [ -f "$STATE/had-server" ]; then
		while IFS= read -r server; do
			case "$server" in
				/*) [ "$server" = '/#/' ] || uci add_list "$SECTION.server=$server" ;;
			esac
		done < "$STATE/server"
	fi
	uci add_list "$SECTION.server=127.0.0.1#1053"
	uci commit dhcp
	if ! /etc/init.d/dnsmasq reload; then
		restore
		return 1
	fi
}

case "${1:-}" in
	apply) apply ;;
	remove) restore ;;
	*) echo 'usage: terryclash-dns apply|remove' >&2; exit 2 ;;
esac
